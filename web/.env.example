# Supabase project (Settings > API). Without a URL the site runs on local JSON stores in .data/.
# The server is the only client and uses the service role key; the anon key can't do anything
# (migration 20261017090000), so it isn't needed. Server only: never prefix these NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: secret for the daily IP hash used against abuse (defaults to a hash of the key above).
ABUSE_HASH_SECRET=
# Optional: webhook (Slack, Discord, Zapier/Make → email) told when reports hide a hand or comment.
MODERATION_WEBHOOK_URL=
# RevenueCat secret API key (Project settings > API keys > Secret) and the Pro entitlement id.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro
# Optional: PostHog project API key. Set, every funnel event is also sent to PostHog
# (anonymous install id, no IP, no free text). Empty = off. Host defaults to the EU cloud.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Public origin used in share links and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://sweatbook.poker

# Brand (placeholder until the final name is chosen).
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Optional: App Store Connect provider token, added as pt= to App Store campaign links.
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=
# Custom URL scheme of the mobile app, used for "open in app".
NEXT_PUBLIC_APP_SCHEME=sweatbook

# Universal links / App Links for /h/<id> (served at /.well-known/*).
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.ruinf.sweatbook
ANDROID_PACKAGE=com.ruinf.sweatbook
ANDROID_CERT_SHA256=
