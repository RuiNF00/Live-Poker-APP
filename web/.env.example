# Supabase project (Settings > API). Without these the site runs on a local JSON store in .data/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (never NEXT_PUBLIC): needed for invites, which grant Pro from the server.
SUPABASE_SERVICE_ROLE_KEY=
# RevenueCat secret API key (Project settings > API keys > Secret) and the Pro entitlement id.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro

# Public origin used in share links and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://sweatbook.poker

# Brand (placeholder until the final name is chosen).
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Optional: App Store Connect provider token, added as pt= to App Store campaign links.
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=
# Custom URL scheme of the mobile app, used for "open in app".
NEXT_PUBLIC_APP_SCHEME=sweatbook

# Universal links / App Links for /h/<id> (served at /.well-known/*).
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.ruinf.sweatbook
ANDROID_PACKAGE=com.ruinf.sweatbook
ANDROID_CERT_SHA256=
