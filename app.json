        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.ruinf.sweatbook",
      "adaptiveIcon": {
        "backgroundColor": "#F45A27",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sweatbook.poker",
              "pathPrefix": "/h/"
            },
            {
              "scheme": "https",
              "host": "sweatbook.poker",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "sweatbook.poker",
              "pathPrefix": "/live/"
            },
            {
              "scheme": "https",
              "host": "sweatbook.poker",
              "pathPrefix": "/swap/"
            },
            {
              "scheme": "https",
              "host": "sweatbook.poker",
              "pathPrefix": "/b"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "Sweatbook",
      "themeColor": "#0C1311",
      "backgroundColor": "#0C1311"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-async-storage-size",
      "./plugins/with-android-backup",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1311",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Sweatbook usa o microfone para gravares notas de voz sobre as tuas mãos e para as histórias e os vídeos das mãos.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Sweatbook usa as tuas fotos para guardares recibos e formulários de impostos junto das tuas sessões.",
          "cameraPermission": "O Sweatbook usa a câmara para fotografares recibos, formulários de impostos (W-2G, 1042-S) e a folha da estrutura de um torneio, e para gravares a tua cara nos vídeos das mãos."
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "instagram-stories",
            "instagram"
          ],
          "android": [
            "com.instagram.android",
            "com.whatsapp",
            "com.twitter.android"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Sweatbook usa o Face ID para desbloquear a app, se ligares o bloqueio nas Definições."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6A3D"
        }
      ],
      "./plugins/with-widget-privacy",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "SweatbookHome",
              "displayName": "Sweatbook",
              "description": "Sessão a decorrer ou o resultado da semana.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            }
          ]
        }
      ],
      "expo-background-task",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "pt",
            "pt-BR",
            "en",
            "es"
          ]
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "pt": "./locales/pt.json",
      "pt-BR": "./locales/pt-BR.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "extra": {
      "eas": {
        "projectId": "5e332dae-8677-4190-acbc-7912f606869b"
      }
    }
  }
}
