{
  "expo": {
    "name": "Sweatbook",
    "slug": "sweatbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sweatbook",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C1311",
    "ios": {
      "bundleIdentifier": "com.ruinf.sweatbook",
      "supportsTablet": false,
      "associatedDomains": ["applinks:sweatbook.poker"],
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ]
      }
    },
    "android": {
      "package": "com.ruinf.sweatbook",
      "adaptiveIcon": {
        "backgroundColor": "#0C1311",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "sweatbook.poker", "pathPrefix": "/h/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "Sweatbook",
      "themeColor": "#0C1311",
      "backgroundColor": "#0C1311"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1311",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      ["expo-build-properties", { "android": { "targetSdkVersion": 36, "compileSdkVersion": 36 } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
